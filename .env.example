VERITYGRAPH_ENV=development
VERITYGRAPH_API_HOST=0.0.0.0
VERITYGRAPH_API_PORT=8000
VERITYGRAPH_FRONTEND_ORIGIN=http://localhost:5173
VERITYGRAPH_DATABASE_PATH=data/veritygraph.db
VERITYGRAPH_MAX_UPLOAD_BYTES=10485760

VERITYGRAPH_WIKIPEDIA_PROVIDER=live
VERITYGRAPH_WIKIPEDIA_ENDPOINT=https://en.wikipedia.org/w/api.php
VERITYGRAPH_WIKIPEDIA_LANGUAGE=en
VERITYGRAPH_WIKIPEDIA_TIMEOUT_SECONDS=12

VERITYGRAPH_WEB_PROVIDER=live
VERITYGRAPH_WEB_TIMEOUT_SECONDS=12
VERITYGRAPH_WEB_MAX_CONTENT_BYTES=3145728
VERITYGRAPH_WEB_MAX_REDIRECTS=4

VITE_API_BASE_URL=/api
