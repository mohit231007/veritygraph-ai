# Copy this file to .env.production on the server. Do not commit real credentials.
VERITYGRAPH_DOMAIN=veritygraph.example.com

# Normal public/shared deployment:
VERITYGRAPH_CADDYFILE=./deploy/Caddyfile

# For a password-protected demo, use:
# VERITYGRAPH_CADDYFILE=./deploy/Caddyfile.protected
# VERITYGRAPH_AUTH_USER=demo
# Generate the password hash as described in docs/deployment.md, then put it in
# single quotes when storing it in this env file so dollar signs remain literal.
# VERITYGRAPH_AUTH_PASSWORD_HASH='$2a$14$replace_with_generated_caddy_hash'

VERITYGRAPH_WIKIPEDIA_PROVIDER=live
VERITYGRAPH_WEB_PROVIDER=live
